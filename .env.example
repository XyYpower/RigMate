# RigMate local configuration
RIGMATE_DB_PATH=./data/rigmate.db
# BuildCores 目录导入产物路径（可选，默认 ./data/catalog/buildcores.json；文件不存在时目录只有人工种子）
# RIGMATE_BUILDCORES_CATALOG_PATH=./data/catalog/buildcores.json

# 大模型意图解析（M30，可选）：不配 API key = 关闭，系统自动用本地规则解析目标
# OpenAI 兼容接口均可（官方 / 网关 / 中转），只要支持 /chat/completions
# RIGMATE_LLM_API_KEY=sk-xxx
# RIGMATE_LLM_BASE_URL=https://api.openai.com/v1
# RIGMATE_LLM_MODEL=gpt-4o-mini
# RIGMATE_LLM_TIMEOUT_MS=12000
