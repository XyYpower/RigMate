# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# local runtime data（数据库 / 目录导入产物 / 上游数据克隆等本地数据层）
/data/*
# 受约束选件固定评测案例（内核恢复 Task D）：案例入库，运行报告不入库
!/data/evals/
/data/evals/*
!/data/evals/design-selection-cases.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI 工具运行时状态
.superpowers/
.worktrees/
